async function analyzeChart() {

  const loader = document.getElementById('loader');
  const results = document.getElementById('results');

  loader.style.display = 'block';
  results.style.display = 'none';

  const signalRes = await fetch("http://127.0.0.1:5000/signal/BTCUSD");
  const signalData = await signalRes.json();

  const accountRes = await fetch("http://127.0.0.1:5000/account");
  const accountData = await accountRes.json();

  loader.style.display = 'none';
  results.style.display = 'grid';

  document.getElementById("signalText").innerText = signalData.signal;
  document.getElementById("entry").innerText = signalData.entry;
  document.getElementById("confidence").innerText = signalData.confidence + "%";

  document.getElementById("tp").innerText = (signalData.entry * 1.002).toFixed(2);
  document.getElementById("sl").innerText = (signalData.entry * 0.998).toFixed(2);

  document.getElementById("rr").innerText = "1 : 2";

}
